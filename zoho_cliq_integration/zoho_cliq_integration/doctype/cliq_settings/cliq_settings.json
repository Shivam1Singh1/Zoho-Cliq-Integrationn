   "fieldtype": "Section Break",
   "label": "In-Place Updates (OAuth)"
  },
  {
   "fieldname": "oauth_help",
   "fieldtype": "HTML",
   "options": "<p class='text-muted small'>Only needed to <b>edit a message after it was sent</b> &mdash; for example flipping a Material Request card from Pending to Approved without sending a second message. A zapikey cannot do this: Zoho requires an OAuth token with the <code>ZohoCliq.Messages.UPDATE</code> scope. Leave empty and messages are sent exactly as before and never updated.</p>"
  },
