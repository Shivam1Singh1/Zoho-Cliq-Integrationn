   "label": "Refresh Token"
  },
  {
   "fieldname": "accounts_domain",
   "fieldtype": "Data",
   "label": "Accounts Domain",
   "description": "Where tokens are refreshed. Left empty, it follows API Domain: cliq.zoho.in gives accounts.zoho.in."
  },
  {
   "fieldname": "action_section",
   "fieldtype": "Section Break",
   "label": "Approve from Cliq"
  },
  {
   "fieldname": "action_help",
   "fieldtype": "HTML",
   "options": "<p class='text-muted small'>Fill both to put <b>Approve</b> and <b>Reject</b> buttons on pending cards. They invoke a function you create in the Cliq Developer Console, which calls back into ERPNext and rewrites the card with the new status. Leave either empty and cards carry only the link button, exactly as before. The Deluge body to paste is in <code>cliq_function.deluge</code>.</p>"
  },
  {
   "fieldname": "function_name",
   "fieldtype": "Data",
   "label": "Cliq Function Name",
   "description": "The function's name in the Cliq console, e.g. erp_mr_action."
  },
  {
   "fieldname": "column_break_action",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "function_owner",
   "fieldtype": "Data",
   "label": "Cliq Function Owner",
   "description": "Email of whoever created that function. Cliq needs it to resolve the name."
  }
